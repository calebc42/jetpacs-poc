<?xml version="1.0" encoding="utf-8"?>
<!--
  Back up nothing, transfer nothing.

  Production protocol state lives in the pairing-partitioned Room database and
  is one of two things: an OUTBOX of events owed to one specific Emacs pairing,
  or a CACHE of state that Emacs can re-push. Restoring it onto another device
  could redeliver actions, duplicate fired reminders, restore device-specific
  trigger history, or make fresh surface revisions look stale.

  Pre-cutover JSON stores and the disposable prototype database are quarantined:
  production code neither reads nor deletes them. Transfer must not resurrect
  those stale stores either.

  The exclusions are BLANKET by domain rather than per-filename on purpose: a
  store added later is then covered by default. An opt-in list would silently
  omit it, and the failure mode is duplicate delivery — silent and expensive to
  diagnose.

  minSdk is 34, so this file (API 31+) is the only mechanism that applies;
  the legacy pre-31 `fullBackupContent` attribute is deliberately absent.
-->
<data-extraction-rules>
    <!-- Cloud backup. Belt-and-braces with android:allowBackup="false". -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>

    <!-- Device-to-device transfer. This is the channel allowBackup="false"
         leaves open on Android 12+, and the one that actually matters here:
         D2D is exactly the "same user, new phone" case that would replay a
         restored queue against a live pairing. -->
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
