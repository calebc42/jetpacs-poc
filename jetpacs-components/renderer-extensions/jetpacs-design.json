{
  "format": 2,
  "extension": "jetpacs.design",
  "description": "Jetpacs' bounded Elisp-authored Foundation design runtime.",
  "node_types": [
    "jetpacs.design_scope",
    "jetpacs.styled",
    "jetpacs.pressable",
    "jetpacs.glyph",
    "jetpacs.inline_text",
    "jetpacs.inline",
    "jetpacs.wheel",
    "jetpacs.state_switch"
  ],
  "targets": {
    "app": [
      "jetpacs.design_scope",
      "jetpacs.styled",
      "jetpacs.pressable",
      "jetpacs.glyph",
      "jetpacs.inline_text",
      "jetpacs.inline",
      "jetpacs.wheel",
      "jetpacs.state_switch"
    ],
    "dialog": [
      "jetpacs.design_scope",
      "jetpacs.styled",
      "jetpacs.pressable",
      "jetpacs.glyph",
      "jetpacs.inline_text",
      "jetpacs.inline",
      "jetpacs.wheel",
      "jetpacs.state_switch"
    ],
    "notification": []
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "min_length": 1,
      "max_length": 128
    },
    "design-value": {
      "type": "object",
      "required": {
        "kind": {
          "type": "enum",
          "values": [
            "boolean",
            "color",
            "dimension",
            "font-family",
            "font-weight",
            "number",
            "theme-role",
            "text-align",
            "token"
          ]
        },
        "value": {
          "type": "string",
          "min_length": 1,
          "max_length": 256
        }
      },
      "optional": {}
    },
    "property-map": {
      "type": "identifier-map",
      "values": {
        "type": "ref",
        "ref": "design-value"
      },
      "min_entries": 0,
      "max_entries": 64
    },
    "state-rule": {
      "type": "object",
      "required": {
        "state": {
          "type": "enum",
          "values": [
            "disabled",
            "selected",
            "toggled",
            "hovered",
            "focused",
            "pressed"
          ]
        },
        "properties": {
          "type": "ref",
          "ref": "property-map"
        }
      },
      "optional": {
        "motion": {
          "type": "ref",
          "ref": "identifier"
        }
      }
    },
    "style": {
      "type": "object",
      "required": {
        "properties": {
          "type": "ref",
          "ref": "property-map"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "state-rule"
          },
          "min_items": 0,
          "max_items": 16
        }
      },
      "optional": {
        "motion": {
          "type": "ref",
          "ref": "identifier"
        }
      }
    },
    "motion": {
      "type": "object",
      "required": {
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "easing": {
          "type": "enum",
          "values": [
            "linear",
            "ease-in",
            "ease-out",
            "ease-in-out",
            "spring"
          ]
        }
      },
      "optional": {}
    },
    "token-map": {
      "type": "identifier-map",
      "values": {
        "type": "ref",
        "ref": "design-value"
      },
      "min_entries": 0,
      "max_entries": 256
    },
    "style-map": {
      "type": "identifier-map",
      "values": {
        "type": "ref",
        "ref": "style"
      },
      "min_entries": 0,
      "max_entries": 256
    },
    "motion-map": {
      "type": "identifier-map",
      "values": {
        "type": "ref",
        "ref": "motion"
      },
      "min_entries": 0,
      "max_entries": 64
    },
    "style-references": {
      "type": "array",
      "items": {
        "type": "ref",
        "ref": "identifier"
      },
      "min_items": 1,
      "max_items": 16
    },
    "component-style-slot": {
      "type": "enum",
      "values": [
        "text.body",
        "text.title",
        "text.headline",
        "text.caption",
        "text.label",
        "text.mono",
        "card.filled",
        "card.elevated",
        "card.outlined",
        "list-item.container",
        "list-item.overline",
        "list-item.title",
        "list-item.subtitle",
        "swipe.cell",
        "swipe.label",
        "swipe.popup",
        "swipe.popup-button",
        "icon-button.container",
        "badge.container",
        "badge.label",
        "empty-state.container",
        "empty-state.title",
        "empty-state.caption",
        "button.filled",
        "button.tonal",
        "button.elevated",
        "button.outlined",
        "button.text",
        "button.label",
        "chip.container",
        "chip.label",
        "divider.line",
        "section-header.container",
        "section-header.title",
        "menu.trigger",
        "menu.container",
        "menu.item",
        "menu.item-label",
        "menu.item-supporting",
        "menu.group-label",
        "switch.track",
        "switch.thumb",
        "switch.label",
        "collapsible.header",
        "collapsible.chevron",
        "collapsible.body",
        "month-grid.container",
        "month-grid.header",
        "month-grid.nav",
        "month-grid.weekday",
        "month-grid.day",
        "month-grid.today",
        "month-grid.range",
        "month-grid.mark",
        "action.container",
        "action.label",
        "choice.container",
        "choice.indicator",
        "choice.label",
        "panel.container",
        "panel.label",
        "picker.container",
        "picker.label",
        "tabs.container",
        "tabs.item",
        "tabs.indicator",
        "tabs.label",
        "section-navigator.container",
        "section-navigator.option",
        "section-navigator.label",
        "section-navigator.button",
        "section-navigator.selector",
        "section-navigator.popup",
        "section-navigator.popup-item",
        "text-field.outlined",
        "text-field.filled",
        "text-field.text",
        "text-field.label",
        "text-field.placeholder",
        "text-field.supporting",
        "text-field.affix",
        "dropdown.field",
        "dropdown.text",
        "dropdown.label",
        "dropdown.popup",
        "dropdown.item",
        "editor.surface",
        "editor.chromeless",
        "editor.text",
        "editor.gutter",
        "editor.placeholder",
        "editor.toolbar",
        "editor.toolbar-item",
        "editor.sync-status",
        "editor.completion-list",
        "editor.completion-item",
        "editor.candidate-document",
        "editor.tooling-status",
        "editor.syntax.comment",
        "editor.syntax.string",
        "editor.syntax.keyword",
        "editor.syntax.function",
        "editor.syntax.constant",
        "editor.syntax.variable",
        "editor.syntax.type",
        "editor.syntax.number",
        "editor.syntax.operator",
        "editor.syntax.preprocessor",
        "editor.syntax.heading",
        "editor.syntax.link",
        "editor.syntax.todo",
        "editor.syntax.done",
        "editor.syntax.tag",
        "editor.syntax.heading-1",
        "editor.syntax.heading-2",
        "editor.syntax.heading-3",
        "editor.syntax.heading-4",
        "editor.syntax.heading-5",
        "editor.syntax.heading-6",
        "editor.syntax.heading-7",
        "editor.syntax.heading-8",
        "chrome.tab-label",
        "chrome.tab-indicator",
        "chrome.rail-label",
        "chrome.rail-indicator",
        "chrome.rail",
        "chrome.drawer",
        "chrome.scrim",
        "chrome.bottom-bar",
        "chrome.dialog",
        "chrome.snackbar"
      ]
    },
    "component-style-binding": {
      "type": "object",
      "required": {
        "slot": {
          "type": "ref",
          "ref": "component-style-slot"
        },
        "styles": {
          "type": "ref",
          "ref": "style-references"
        }
      },
      "optional": {}
    },
    "component-style-bindings": {
      "type": "array",
      "items": {
        "type": "ref",
        "ref": "component-style-binding"
      },
      "min_items": 0,
      "max_items": 256
    },
    "theme-role-map": {
      "type": "identifier-map",
      "values": {
        "type": "ref",
        "ref": "design-value"
      },
      "min_entries": 0,
      "max_entries": 13
    }
  },
  "node_schema": {
    "jetpacs.design_scope": {
      "description": "The root of the Elisp-authored design runtime: tokens, named styles, motions and component styles that its subtree may reference.",
      "required": {
        "tokens": {
          "type": "ref",
          "ref": "token-map",
          "description": "Named design tokens the styles resolve."
        },
        "styles": {
          "type": "ref",
          "ref": "style-map",
          "description": "Named styles available to jetpacs.styled and jetpacs.pressable beneath."
        },
        "children": {
          "type": "node-array",
          "min_items": 0,
          "max_items": 10000
        }
      },
      "optional": {
        "motions": {
          "type": "ref",
          "ref": "motion-map"
        },
        "component_styles": {
          "type": "ref",
          "ref": "component-style-bindings"
        },
        "theme_roles": {
          "type": "ref",
          "ref": "theme-role-map"
        }
      }
    },
    "jetpacs.styled": {
      "description": "Applies named styles from the enclosing design scope to its children.",
      "required": {
        "styles": {
          "type": "ref",
          "ref": "style-references",
          "description": "The style names applied, in order."
        },
        "children": {
          "type": "node-array",
          "min_items": 0,
          "max_items": 10000
        }
      },
      "optional": {}
    },
    "jetpacs.pressable": {
      "description": "A styled pressable region dispatching on_tap and on_long_tap, with enabled, selected and toggled presentation states and optional swipe sides.",
      "required": {
        "styles": {
          "type": "ref",
          "ref": "style-references",
          "description": "The style names applied, in order."
        },
        "on_tap": {
          "type": "action",
          "description": "The action dispatched by a tap."
        },
        "children": {
          "type": "node-array",
          "min_items": 1,
          "max_items": 16
        }
      },
      "optional": {
        "enabled": {
          "type": "boolean"
        },
        "selected": {
          "type": "boolean"
        },
        "toggled": {
          "type": "boolean"
        },
        "swipe_start": {
          "type": "swipe-side",
          "description": "Actions revealed, or shown as a popup, by a swipe toward the start edge (SPEC 17.3)."
        },
        "swipe_end": {
          "type": "swipe-side",
          "description": "Actions revealed, or shown as a popup, by a swipe toward the end edge (SPEC 17.3)."
        },
        "on_long_tap": {
          "type": "action",
          "description": "The action dispatched by a long press (SPEC 17.3 on_long_tap)."
        }
      }
    },
    "jetpacs.glyph": {
      "description": "A vector glyph: SVG path data in a viewport, fitted into a square of size dp and filled in color, as a toolkit icon draws an app’s own vector.",
      "required": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "min_length": 1,
            "max_length": 16384
          },
          "min_items": 1,
          "max_items": 8,
          "description": "SVG path data, filled nonzero, in viewport units."
        },
        "viewport_width": {
          "type": "number",
          "minimum": 1,
          "maximum": 100000
        },
        "viewport_height": {
          "type": "number",
          "minimum": 1,
          "maximum": 100000
        },
        "size": {
          "type": "number",
          "minimum": 0,
          "maximum": 1024,
          "description": "The square the viewport is fitted into, in dp."
        }
      },
      "optional": {
        "color": {
          "type": "string",
          "min_length": 1,
          "max_length": 64,
          "description": "A #RRGGBB or #RRGGBBAA color or an EBP theme role; the enclosing content color by default."
        },
        "content_description": {
          "type": "string",
          "min_length": 0,
          "max_length": 512
        }
      }
    },
    "jetpacs.inline_text": {
      "description": "One paragraph whose text children flow as text and whose jetpacs.inline children ride in it as placeholders, wrapping with the words.",
      "required": {
        "children": {
          "type": "node-array",
          "min_items": 1,
          "max_items": 512
        }
      },
      "optional": {
        "style": {
          "type": "string",
          "min_length": 1,
          "max_length": 32,
          "description": "The canonical text style the paragraph takes, as a text node’s style."
        }
      }
    },
    "jetpacs.inline": {
      "description": "A node riding in a jetpacs.inline_text paragraph. Its placeholder is the width of reserve_text at reserve_text_size plus reserve_extra, at most reserve_max, and height sp tall, centred on the text; outside a paragraph the child renders alone.",
      "required": {
        "child": {
          "type": "node"
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 512,
          "description": "The placeholder height, in sp."
        }
      },
      "optional": {
        "reserve_text": {
          "type": "string",
          "min_length": 0,
          "max_length": 1024
        },
        "reserve_text_size": {
          "type": "number",
          "minimum": 1,
          "maximum": 200,
          "description": "The font size reserve_text is measured at, in sp; 14 by default."
        },
        "reserve_extra": {
          "type": "number",
          "minimum": 0,
          "maximum": 1024,
          "description": "Width added to the measured text, in dp."
        },
        "reserve_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 4096,
          "description": "The most width the placeholder takes, in dp."
        }
      }
    },
    "jetpacs.wheel": {
      "description": "A stateful selector wheel: one of values, scrolled into the middle of a spinning column, as the platform's number picker draws it. Its published value is the selected string.",
      "required": {
        "id": {
          "type": "ref",
          "ref": "identifier",
          "description": "The stateful node id drafts, captures and state.changed address."
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "min_length": 1,
            "max_length": 64
          },
          "min_items": 1,
          "max_items": 256,
          "description": "The choices, top to bottom."
        },
        "value": {
          "type": "string",
          "min_length": 1,
          "max_length": 64,
          "description": "The selected choice; one of values."
        }
      },
      "optional": {
        "wrap": {
          "type": "boolean",
          "description": "Whether scrolling past the last choice wraps to the first; false by default."
        },
        "enabled": {
          "type": "boolean"
        },
        "color": {
          "type": "string",
          "min_length": 1,
          "max_length": 64,
          "description": "The choices' text color: #RRGGBB, #RRGGBBAA or an EBP theme role."
        },
        "divider_color": {
          "type": "string",
          "min_length": 1,
          "max_length": 64,
          "description": "The selection dividers' color."
        },
        "on_change": {
          "type": "action",
          "description": "Dispatched after a settled change with the selected choice injected as args.value."
        }
      }
    },
    "jetpacs.state_switch": {
      "description": "Shows the one child whose entry in values equals another stateful node's current value, as the user sets it (a hint that follows a wheel), else `otherwise`. An empty string matches an empty value. Display only: it publishes nothing, and its children should hold no stateful node.",
      "required": {
        "source": {
          "type": "ref",
          "ref": "identifier",
          "description": "The id of the stateful node, in the same surface or dialog, whose value chooses the child."
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "min_length": 0,
            "max_length": 64
          },
          "min_items": 1,
          "max_items": 256,
          "description": "One value per child, in order; the child whose value matches is shown, `otherwise` when none does."
        },
        "children": {
          "type": "node-array",
          "min_items": 1,
          "max_items": 256
        }
      },
      "optional": {
        "otherwise": {
          "type": "node",
          "description": "Shown when no value matches the source's."
        }
      }
    }
  },
  "stateful_when_present": {
    "jetpacs.wheel": "value"
  },
  "at_least_one_non_empty": {}
}
