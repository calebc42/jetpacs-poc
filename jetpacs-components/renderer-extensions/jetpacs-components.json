{
  "format": 2,
  "extension": "jetpacs.components",
  "description": "Jetpacs' editor-native component design for Compose Foundation.",
  "node_types": [
    "jetpacs.action",
    "jetpacs.choice",
    "jetpacs.list_item",
    "jetpacs.panel",
    "jetpacs.scope",
    "jetpacs.section_navigator",
    "jetpacs.tabs"
  ],
  "targets": {
    "app": [
      "jetpacs.action",
      "jetpacs.choice",
      "jetpacs.list_item",
      "jetpacs.panel",
      "jetpacs.scope",
      "jetpacs.section_navigator",
      "jetpacs.tabs"
    ],
    "dialog": [],
    "notification": []
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "min_length": 1,
      "max_length": 128
    },
    "text": {
      "type": "string",
      "min_length": 0,
      "max_length": 4096
    },
    "option-value": {
      "type": "string",
      "min_length": 1,
      "max_length": 4096
    },
    "line-limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "children": {
      "type": "node-array",
      "min_items": 0,
      "max_items": 10000
    },
    "tab-option": {
      "type": "object",
      "required": {
        "label": {
          "type": "ref",
          "ref": "text"
        },
        "value": {
          "type": "ref",
          "ref": "option-value"
        }
      },
      "optional": {}
    },
    "section-option": {
      "type": "object",
      "required": {
        "label": {
          "type": "ref",
          "ref": "text"
        },
        "value": {
          "type": "ref",
          "ref": "option-value"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      },
      "optional": {}
    },
    "tab-options": {
      "type": "array",
      "items": {
        "type": "ref",
        "ref": "tab-option"
      },
      "min_items": 1,
      "max_items": 10000
    },
    "section-options": {
      "type": "array",
      "items": {
        "type": "ref",
        "ref": "section-option"
      },
      "min_items": 1,
      "max_items": 10000
    }
  },
  "node_schema": {
    "jetpacs.action": {
      "description": "A labeled Jetpacs action control that dispatches on_tap; the editor-native button of the components design.",
      "required": {
        "label": {
          "type": "ref",
          "ref": "text",
          "description": "The visible label."
        },
        "on_tap": {
          "type": "action",
          "description": "The action dispatched by a tap."
        }
      },
      "optional": {
        "enabled": {
          "type": "boolean",
          "description": "Whether the control accepts input; absent means enabled."
        }
      }
    },
    "jetpacs.choice": {
      "description": "One stateful yes/no choice: a labeled checkable row whose on_change carries the next boolean.",
      "required": {
        "id": {
          "type": "ref",
          "ref": "identifier",
          "description": "The stateful node id drafts and state.changed address."
        },
        "label": {
          "type": "ref",
          "ref": "text"
        },
        "checked": {
          "type": "boolean",
          "description": "The published boolean value."
        },
        "on_change": {
          "type": "action",
          "description": "Dispatched with the next value injected as args.value."
        }
      },
      "optional": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "jetpacs.list_item": {
      "description": "A flat list row with title, optional overline, subtitle, leading and trailing slots, tap and long-tap actions, swipe sides and selection.",
      "required": {
        "title": {
          "type": "ref",
          "ref": "text",
          "description": "The primary line."
        }
      },
      "optional": {
        "overline": {
          "type": "ref",
          "ref": "text",
          "description": "A short line above the title."
        },
        "subtitle": {
          "type": "ref",
          "ref": "text",
          "description": "A secondary line below the title."
        },
        "title_max_lines": {
          "type": "ref",
          "ref": "line-limit",
          "description": "Line limit for the title before it is truncated."
        },
        "subtitle_max_lines": {
          "type": "ref",
          "ref": "line-limit",
          "description": "Line limit for the subtitle before it is truncated."
        },
        "leading": {
          "type": "node",
          "description": "A node shown before the text, such as an icon."
        },
        "trailing": {
          "type": "node",
          "description": "A node shown after the text, such as a chevron or control."
        },
        "on_tap": {
          "type": "action"
        },
        "on_long_tap": {
          "type": "action"
        },
        "swipe_start": {
          "type": "swipe-side"
        },
        "swipe_end": {
          "type": "swipe-side"
        },
        "selected": {
          "type": "boolean",
          "description": "Whether the row is drawn selected."
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "jetpacs.panel": {
      "description": "A labeled panel grouping its children under one heading.",
      "required": {
        "label": {
          "type": "ref",
          "ref": "text",
          "description": "The panel heading."
        },
        "children": {
          "type": "ref",
          "ref": "children"
        }
      },
      "optional": {}
    },
    "jetpacs.scope": {
      "description": "Selects Jetpacs core rendering for canonical EBP children, so a mixed design screen can hand a subtree back to the core components.",
      "required": {
        "children": {
          "type": "ref",
          "ref": "children"
        }
      },
      "optional": {}
    },
    "jetpacs.section_navigator": {
      "description": "A stateful hierarchical section navigator over leveled section options; on_change carries the selected section value.",
      "required": {
        "id": {
          "type": "ref",
          "ref": "identifier"
        },
        "options": {
          "type": "ref",
          "ref": "section-options",
          "description": "The leveled section options, each a label, a stable value and a level from 1."
        },
        "value": {
          "type": "ref",
          "ref": "option-value",
          "description": "The selected section's value."
        },
        "on_change": {
          "type": "action"
        }
      },
      "optional": {
        "enabled": {
          "type": "boolean"
        },
        "pinned": {
          "type": "boolean",
          "description": "Keep the navigator visible while its lazy column scrolls; only under a lazy_column."
        }
      }
    },
    "jetpacs.tabs": {
      "description": "A stateful tab strip over tab options; on_change carries the selected tab value, variant and pinning are presentation hints.",
      "required": {
        "id": {
          "type": "ref",
          "ref": "identifier"
        },
        "options": {
          "type": "ref",
          "ref": "tab-options",
          "description": "The tab options, each a label and a stable value."
        },
        "value": {
          "type": "ref",
          "ref": "option-value",
          "description": "The selected tab's value."
        },
        "on_change": {
          "type": "action"
        }
      },
      "optional": {
        "enabled": {
          "type": "boolean"
        },
        "scrollable": {
          "type": "boolean",
          "description": "Let the strip scroll instead of squeezing its tabs."
        },
        "pinned": {
          "type": "boolean",
          "description": "Keep the strip visible while its lazy column scrolls; only under a lazy_column."
        },
        "variant": {
          "type": "string",
          "min_length": 1,
          "max_length": 64,
          "description": "A bounded presentation name; an unknown variant renders as the default, so new names stay forward-compatible."
        }
      }
    }
  },
  "stateful_when_present": {
    "jetpacs.choice": "checked"
  },
  "at_least_one_non_empty": {
    "jetpacs.action": [
      "label"
    ],
    "jetpacs.choice": [
      "label"
    ],
    "jetpacs.panel": [
      "label"
    ]
  },
  "selection_options": {
    "jetpacs.section_navigator": {
      "options_member": "options",
      "selection_member": "value",
      "label_member": "label",
      "value_member": "value",
      "required_option_members": {
        "level": "integer-1-6"
      },
      "optional_option_members": {}
    },
    "jetpacs.tabs": {
      "options_member": "options",
      "selection_member": "value",
      "label_member": "label",
      "value_member": "value"
    }
  },
  "true_requires_parent": {
    "jetpacs.section_navigator": {
      "member": "pinned",
      "parent_types": [
        "lazy_column"
      ]
    },
    "jetpacs.tabs": {
      "member": "pinned",
      "parent_types": [
        "lazy_column"
      ]
    }
  },
  "lazy_column_sticky_members": {
    "jetpacs.section_navigator": "pinned",
    "jetpacs.tabs": "pinned"
  }
}
