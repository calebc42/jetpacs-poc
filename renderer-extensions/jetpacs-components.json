{
  "format": 1,
  "extension": "jetpacs.components",
  "description": "Jetpacs' editor-native component design for Compose Foundation.",
  "node_types": [
    "jetpacs.action",
    "jetpacs.choice",
    "jetpacs.panel",
    "jetpacs.scope"
  ],
  "targets": {
    "app": [
      "jetpacs.action",
      "jetpacs.choice",
      "jetpacs.panel",
      "jetpacs.scope"
    ],
    "dialog": [],
    "notification": []
  },
  "node_schema": {
    "jetpacs.action": {
      "required": ["label", "on_tap"],
      "optional": ["enabled"]
    },
    "jetpacs.choice": {
      "required": ["id", "label", "checked", "on_change"],
      "optional": ["enabled"]
    },
    "jetpacs.panel": {
      "required": ["label", "children"],
      "optional": []
    },
    "jetpacs.scope": {
      "required": ["children"],
      "optional": []
    }
  },
  "stateful_when_present": {
    "jetpacs.choice": "checked"
  },
  "at_least_one_non_empty": {
    "jetpacs.action": ["label"],
    "jetpacs.choice": ["label"],
    "jetpacs.panel": ["label"]
  }
}
