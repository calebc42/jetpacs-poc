{
  "format": 1,
  "extension": "glasspane.material3",
  "description": "Glasspane's Material 3 design implementation for Jetpacs Compose nodes.",
  "node_types": [
    "material3.assist_chip",
    "material3.split_button",
    "material3.app_bar_row",
    "material3.app_bar_column",
    "material3.fab_menu"
  ],
  "targets": {
    "app": [
      "material3.assist_chip",
      "material3.split_button",
      "material3.app_bar_row",
      "material3.app_bar_column",
      "material3.fab_menu"
    ],
    "dialog": [
      "material3.assist_chip",
      "material3.split_button"
    ],
    "notification": []
  },
  "node_schema": {
    "material3.assist_chip": {
      "required": ["label"],
      "optional": ["on_tap", "icon", "enabled", "variant"]
    },
    "material3.split_button": {
      "required": ["on_tap"],
      "optional": [
        "label",
        "icon",
        "variant",
        "size",
        "trailing_icon",
        "trailing_label",
        "trailing_description",
        "checked",
        "on_change",
        "on_trailing_tap",
        "items",
        "enabled"
      ]
    },
    "material3.app_bar_row": {
      "required": ["items"],
      "optional": ["overflow_icon", "max_items"]
    },
    "material3.app_bar_column": {
      "required": ["items"],
      "optional": ["overflow_icon", "max_items"]
    },
    "material3.fab_menu": {
      "required": ["items"],
      "optional": ["icon", "close_icon"]
    }
  },
  "stateful_when_present": {
    "material3.split_button": "checked"
  },
  "at_least_one_non_empty": {
    "material3.split_button": ["label", "icon"]
  }
}
